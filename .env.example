GEMINI_API_KEY=
GEMINI_MODEL=
FAL_KEY=
# GitHub login on the board (optional). OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:8000/auth/github/callback (or http://<laptop-ip>:8000/... for a phone)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# read:user = public repos only; add "repo" to list and clone private repos
GITHUB_OAUTH_SCOPES=read:user
