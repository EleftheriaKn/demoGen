# DemoCut keys. This file is git-ignored: never commit it, never paste keys in chat.
# The server reads it at start (python -m backend.serve or uvicorn backend.app:app).

# --- Gemini (understand, judge_frames, script, rubric) ---------------------------------------
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The model id A's prompts are tuned for (ask A; the current Flash model).
GEMINI_MODEL=

# --- fal (transcribe, voice, title cards, music) ----------------------------------------------
# Key: https://fal.ai/dashboard/keys
FAL_KEY=

# --- GitHub login on the board (optional) -----------------------------------------------------
# OAuth app: https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:8000/auth/github/callback (phone: http://<laptop-ip>:8000/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# read:user = public repos only; "read:user repo" = private repos too
GITHUB_OAUTH_SCOPES=read:user
